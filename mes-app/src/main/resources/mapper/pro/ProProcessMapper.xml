<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.pro.mapper.ProProcessMapper">

    <resultMap type="com.carels.mes.module.pro.domain.ProProcess" id="ProProcessResult">
        <id property="processId" column="process_id"/>
        <result property="processCode" column="process_code"/>
        <result property="processName" column="process_name"/>
        <result property="workshopId" column="workshop_id"/>
        <result property="workshopName" column="workshop_name"/>
        <result property="processType" column="process_type"/>
        <result property="standardHours" column="standard_hours"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectProProcessVo">
        select process_id, process_code, process_name, workshop_id, workshop_name,
               process_type, standard_hours, status, remark,
               create_by, create_time, update_by, update_time
        from pro_process
    </sql>

    <select id="selectProProcessList" parameterType="com.carels.mes.module.pro.domain.ProProcess" resultMap="ProProcessResult">
        <include refid="selectProProcessVo"/>
        <where>
            <if test="processCode != null and processCode != ''">
                AND process_code like concat('%', #{processCode}, '%')
            </if>
            <if test="processName != null and processName != ''">
                AND process_name like concat('%', #{processName}, '%')
            </if>
            <if test="processType != null and processType != ''">
                AND process_type = #{processType}
            </if>
            <if test="workshopId != null">
                AND workshop_id = #{workshopId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectProProcessById" resultMap="ProProcessResult">
        <include refid="selectProProcessVo"/>
        where process_id = #{processId}
    </select>

    <select id="selectProProcessByCode" resultMap="ProProcessResult">
        <include refid="selectProProcessVo"/>
        where process_code = #{processCode}
    </select>

    <select id="selectByWorkshopId" resultMap="ProProcessResult">
        <include refid="selectProProcessVo"/>
        where workshop_id = #{workshopId} and status = '0'
        order by process_code
    </select>

    <insert id="insertProProcess" parameterType="com.carels.mes.module.pro.domain.ProProcess" useGeneratedKeys="true" keyProperty="processId">
        insert into pro_process (
            process_code, process_name, workshop_id, workshop_name, process_type,
            standard_hours, status, remark, create_by, create_time
        ) values (
            #{processCode}, #{processName}, #{workshopId}, #{workshopName}, #{processType},
            #{standardHours}, '0', #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateProProcess" parameterType="com.carels.mes.module.pro.domain.ProProcess">
        update pro_process
        <set>
            <if test="processCode != null">process_code = #{processCode},</if>
            <if test="processName != null">process_name = #{processName},</if>
            <if test="workshopId != null">workshop_id = #{workshopId},</if>
            <if test="workshopName != null">workshop_name = #{workshopName},</if>
            <if test="processType != null">process_type = #{processType},</if>
            <if test="standardHours != null">standard_hours = #{standardHours},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where process_id = #{processId}
    </update>

    <delete id="deleteProProcessById">
        delete from pro_process where process_id = #{processId}
    </delete>

    <delete id="deleteProProcessByIds">
        delete from pro_process where process_id in
        <foreach collection="array" item="processId" open="(" separator="," close=")">
            #{processId}
        </foreach>
    </delete>

    <update id="updateStatus">
        update pro_process
        set status = #{status}, update_time = sysdate()
        where process_id = #{processId}
    </update>

</mapper>
