<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.pro.mapper.ProMaterialReqMapper">

    <resultMap type="com.carels.mes.module.pro.domain.ProMaterialReq" id="ProMaterialReqResult">
        <id property="reqId" column="req_id"/>
        <result property="reqNo" column="req_no"/>
        <result property="planId" column="plan_id"/>
        <result property="planNo" column="plan_no"/>
        <result property="reqDate" column="req_date"/>
        <result property="reqType" column="req_type"/>
        <result property="status" column="status"/>
        <result property="applicantId" column="applicant_id"/>
        <result property="applicantName" column="applicant_name"/>
        <result property="deptName" column="dept_name"/>
        <result property="itemCount" column="item_count"/>
        <result property="totalQty" column="total_qty"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectProMaterialReqVo">
        select req_id, req_no, plan_id, plan_no, req_date, req_type, status, applicant_id,
               applicant_name, dept_name, item_count, total_qty, remark, create_by, create_time,
               update_by, update_time
        from pro_material_req
    </sql>

    <select id="selectProMaterialReqList" parameterType="com.carels.mes.module.pro.domain.ProMaterialReq" resultMap="ProMaterialReqResult">
        <include refid="selectProMaterialReqVo"/>
        <where>
            <if test="reqNo != null and reqNo != ''">
                AND req_no like concat('%', #{reqNo}, '%')
            </if>
            <if test="planNo != null and planNo != ''">
                AND plan_no like concat('%', #{planNo}, '%')
            </if>
            <if test="reqType != null">
                AND req_type = #{reqType}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="applicantName != null and applicantName != ''">
                AND applicant_name like concat('%', #{applicantName}, '%')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectProMaterialReqById" resultMap="ProMaterialReqResult">
        <include refid="selectProMaterialReqVo"/>
        where req_id = #{reqId}
    </select>

    <select id="selectProMaterialReqByNo" resultMap="ProMaterialReqResult">
        <include refid="selectProMaterialReqVo"/>
        where req_no = #{reqNo}
    </select>

    <insert id="insertProMaterialReq" parameterType="com.carels.mes.module.pro.domain.ProMaterialReq" useGeneratedKeys="true" keyProperty="reqId">
        insert into pro_material_req (
            req_no, plan_id, plan_no, req_date, req_type, status, applicant_id, applicant_name,
            dept_name, item_count, total_qty, remark, create_by, create_time
        ) values (
            #{reqNo}, #{planId}, #{planNo}, #{reqDate}, #{reqType}, #{status}, #{applicantId}, #{applicantName},
            #{deptName}, #{itemCount}, #{totalQty}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateProMaterialReq" parameterType="com.carels.mes.module.pro.domain.ProMaterialReq">
        update pro_material_req
        <set>
            <if test="reqNo != null">req_no = #{reqNo},</if>
            <if test="planId != null">plan_id = #{planId},</if>
            <if test="planNo != null">plan_no = #{planNo},</if>
            <if test="reqDate != null">req_date = #{reqDate},</if>
            <if test="reqType != null">req_type = #{reqType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="applicantId != null">applicant_id = #{applicantId},</if>
            <if test="applicantName != null">applicant_name = #{applicantName},</if>
            <if test="deptName != null">dept_name = #{deptName},</if>
            <if test="itemCount != null">item_count = #{itemCount},</if>
            <if test="totalQty != null">total_qty = #{totalQty},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where req_id = #{reqId}
    </update>

    <delete id="deleteProMaterialReqById">
        delete from pro_material_req where req_id = #{reqId}
    </delete>

    <delete id="deleteProMaterialReqByIds">
        delete from pro_material_req where req_id in
        <foreach collection="array" item="reqId" open="(" separator="," close=")">
            #{reqId}
        </foreach>
    </delete>

    <update id="updateStatus">
        update pro_material_req
        set status = #{status}, update_time = sysdate()
        where req_id = #{reqId}
    </update>

</mapper>
