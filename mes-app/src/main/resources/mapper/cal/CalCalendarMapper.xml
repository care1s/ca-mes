<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.cal.mapper.CalCalendarMapper">

    <resultMap type="com.carels.mes.module.cal.domain.CalCalendar" id="CalCalendarResult">
        <id property="calendarId" column="calendar_id"/>
        <result property="calendarDate" column="calendar_date"/>
        <result property="year" column="year"/>
        <result property="month" column="month"/>
        <result property="day" column="day"/>
        <result property="weekDay" column="week_day"/>
        <result property="weekOfYear" column="week_of_year"/>
        <result property="isWorkday" column="is_workday"/>
        <result property="holidayName" column="holiday_name"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectCalCalendarVo">
        select calendar_id, calendar_date, year, month, day, week_day, week_of_year,
               is_workday, holiday_name, status, remark, create_by, create_time
        from cal_calendar
    </sql>

    <select id="selectCalCalendarList" parameterType="com.carels.mes.module.cal.domain.CalCalendar" resultMap="CalCalendarResult">
        <include refid="selectCalCalendarVo"/>
        <where>
            <if test="year != null">
                AND year = #{year}
            </if>
            <if test="month != null">
                AND month = #{month}
            </if>
            <if test="isWorkday != null and isWorkday != ''">
                AND is_workday = #{isWorkday}
            </if>
            <if test="beginDate != null">
                AND calendar_date &gt;= #{beginDate}
            </if>
            <if test="endDate != null">
                AND calendar_date &lt;= #{endDate}
            </if>
        </where>
        order by calendar_date
    </select>

    <select id="selectByDate" resultMap="CalCalendarResult">
        <include refid="selectCalCalendarVo"/>
        where calendar_date = #{calendarDate}
    </select>

    <select id="selectCalCalendarById" resultMap="CalCalendarResult">
        <include refid="selectCalCalendarVo"/>
        where calendar_id = #{calendarId}
    </select>

    <insert id="batchInsert">
        insert into cal_calendar (calendar_date, year, month, day, week_day, week_of_year, is_workday, holiday_name, status, remark, create_by, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.calendarDate}, #{item.year}, #{item.month}, #{item.day}, #{item.weekDay}, #{item.weekOfYear}, #{item.isWorkday}, #{item.holidayName}, #{item.status}, #{item.remark}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>

    <update id="updateCalCalendar" parameterType="com.carels.mes.module.cal.domain.CalCalendar">
        update cal_calendar
        <set>
            <if test="isWorkday != null and isWorkday != ''">is_workday = #{isWorkday},</if>
            <if test="holidayName != null">holiday_name = #{holidayName},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where calendar_id = #{calendarId}
    </update>

    <delete id="deleteCalCalendarById">
        delete from cal_calendar where calendar_id = #{calendarId}
    </delete>

    <delete id="deleteByDateRange">
        delete from cal_calendar where calendar_date &gt;= #{beginDate} and calendar_date &lt;= #{endDate}
    </delete>

</mapper>
