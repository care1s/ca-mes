<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.cal.mapper.CalShiftMapper">

    <resultMap type="com.carels.mes.module.cal.domain.CalShift" id="CalShiftResult">
        <id property="shiftId" column="shift_id"/>
        <result property="shiftCode" column="shift_code"/>
        <result property="shiftName" column="shift_name"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="restStartTime" column="rest_start_time"/>
        <result property="restEndTime" column="rest_end_time"/>
        <result property="workHours" column="work_hours"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectCalShiftVo">
        select shift_id, shift_code, shift_name, start_time, end_time, rest_start_time,
               rest_end_time, work_hours, status, remark, create_by, create_time, update_by, update_time
        from cal_shift
    </sql>

    <select id="selectCalShiftList" parameterType="com.carels.mes.module.cal.domain.CalShift" resultMap="CalShiftResult">
        <include refid="selectCalShiftVo"/>
        <where>
            <if test="shiftCode != null and shiftCode != ''">
                AND shift_code like concat('%', #{shiftCode}, '%')
            </if>
            <if test="shiftName != null and shiftName != ''">
                AND shift_name like concat('%', #{shiftName}, '%')
            </if>
            <if test="keyword != null and keyword != ''">
                AND (shift_code like concat('%', #{keyword}, '%') OR shift_name like concat('%', #{keyword}, '%'))
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by shift_code
    </select>

    <select id="selectAllActiveShifts" resultMap="CalShiftResult">
        <include refid="selectCalShiftVo"/>
        where status = '0'
        order by shift_code
    </select>

    <select id="selectCalShiftById" resultMap="CalShiftResult">
        <include refid="selectCalShiftVo"/>
        where shift_id = #{shiftId}
    </select>

    <insert id="insertCalShift" parameterType="com.carels.mes.module.cal.domain.CalShift" useGeneratedKeys="true" keyProperty="shiftId">
        insert into cal_shift (shift_code, shift_name, start_time, end_time, rest_start_time,
                               rest_end_time, work_hours, status, remark, create_by, create_time)
        values (#{shiftCode}, #{shiftName}, #{startTime}, #{endTime}, #{restStartTime},
                #{restEndTime}, #{workHours}, #{status}, #{remark}, #{createBy}, now())
    </insert>

    <update id="updateCalShift" parameterType="com.carels.mes.module.cal.domain.CalShift">
        update cal_shift
        <set>
            <if test="shiftCode != null and shiftCode != ''">shift_code = #{shiftCode},</if>
            <if test="shiftName != null and shiftName != ''">shift_name = #{shiftName},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="restStartTime != null">rest_start_time = #{restStartTime},</if>
            <if test="restEndTime != null">rest_end_time = #{restEndTime},</if>
            <if test="workHours != null">work_hours = #{workHours},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where shift_id = #{shiftId}
    </update>

    <delete id="deleteCalShiftById">
        delete from cal_shift where shift_id = #{shiftId}
    </delete>

    <delete id="deleteCalShiftByIds">
        delete from cal_shift where shift_id in
        <foreach collection="array" item="shiftId" open="(" separator="," close=")">
            #{shiftId}
        </foreach>
    </delete>

    <select id="checkShiftCodeUnique" resultType="int">
        select count(*) from cal_shift where shift_code = #{shiftCode}
    </select>

</mapper>
