<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.sale.mapper.SaleDeliveryMapper">

    <resultMap type="com.carels.mes.module.sale.domain.SaleDelivery" id="SaleDeliveryResult">
        <id property="deliveryId" column="delivery_id"/>
        <result property="deliveryNo" column="delivery_no"/>
        <result property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="clientId" column="client_id"/>
        <result property="clientName" column="client_name"/>
        <result property="deliveryDate" column="delivery_date"/>
        <result property="warehouseId" column="warehouse_id"/>
        <result property="warehouseName" column="warehouse_name"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="totalQuantity" column="total_quantity"/>
        <result property="status" column="status"/>
        <result property="trackingNo" column="tracking_no"/>
        <result property="logisticsCompany" column="logistics_company"/>
        <result property="shipDate" column="ship_date"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverAddress" column="receiver_address"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSaleDeliveryVo">
        select delivery_id, delivery_no, order_id, order_no, client_id, client_name,
               delivery_date, warehouse_id, warehouse_name, total_amount, total_quantity,
               status, tracking_no, logistics_company, ship_date, receiver_name,
               receiver_phone, receiver_address, remark,
               create_by, create_time, update_by, update_time
        from sale_delivery
    </sql>

    <select id="selectSaleDeliveryList" parameterType="com.carels.mes.module.sale.domain.SaleDelivery" resultMap="SaleDeliveryResult">
        <include refid="selectSaleDeliveryVo"/>
        <where>
            <if test="deliveryNo != null and deliveryNo != ''">
                and delivery_no like concat('%', #{deliveryNo}, '%')
            </if>
            <if test="orderNo != null and orderNo != ''">
                and order_no like concat('%', #{orderNo}, '%')
            </if>
            <if test="clientId != null">
                and client_id = #{clientId}
            </if>
            <if test="clientName != null and clientName != ''">
                and client_name like concat('%', #{clientName}, '%')
            </if>
            <if test="warehouseId != null">
                and warehouse_id = #{warehouseId}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="params != null and params.beginTime != null and params.beginTime != ''">
                and delivery_date &gt;= #{params.beginTime}
            </if>
            <if test="params != null and params.endTime != null and params.endTime != ''">
                and delivery_date &lt;= #{params.endTime}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectSaleDeliveryById" parameterType="Long" resultMap="SaleDeliveryResult">
        <include refid="selectSaleDeliveryVo"/>
        where delivery_id = #{deliveryId}
    </select>

    <select id="selectSaleDeliveryByNo" parameterType="String" resultMap="SaleDeliveryResult">
        <include refid="selectSaleDeliveryVo"/>
        where delivery_no = #{deliveryNo}
    </select>

    <insert id="insertSaleDelivery" parameterType="com.carels.mes.module.sale.domain.SaleDelivery" useGeneratedKeys="true" keyProperty="deliveryId">
        insert into sale_delivery
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deliveryNo != null">delivery_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="clientId != null">client_id,</if>
            <if test="clientName != null">client_name,</if>
            <if test="deliveryDate != null">delivery_date,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="warehouseName != null">warehouse_name,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="totalQuantity != null">total_quantity,</if>
            <if test="status != null">status,</if>
            <if test="trackingNo != null">tracking_no,</if>
            <if test="logisticsCompany != null">logistics_company,</if>
            <if test="shipDate != null">ship_date,</if>
            <if test="receiverName != null">receiver_name,</if>
            <if test="receiverPhone != null">receiver_phone,</if>
            <if test="receiverAddress != null">receiver_address,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deliveryNo != null">#{deliveryNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="clientId != null">#{clientId},</if>
            <if test="clientName != null">#{clientName},</if>
            <if test="deliveryDate != null">#{deliveryDate},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="warehouseName != null">#{warehouseName},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="totalQuantity != null">#{totalQuantity},</if>
            <if test="status != null">#{status},</if>
            <if test="trackingNo != null">#{trackingNo},</if>
            <if test="logisticsCompany != null">#{logisticsCompany},</if>
            <if test="shipDate != null">#{shipDate},</if>
            <if test="receiverName != null">#{receiverName},</if>
            <if test="receiverPhone != null">#{receiverPhone},</if>
            <if test="receiverAddress != null">#{receiverAddress},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateSaleDelivery" parameterType="com.carels.mes.module.sale.domain.SaleDelivery">
        update sale_delivery
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="clientId != null">client_id = #{clientId},</if>
            <if test="clientName != null">client_name = #{clientName},</if>
            <if test="deliveryDate != null">delivery_date = #{deliveryDate},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="warehouseName != null">warehouse_name = #{warehouseName},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="totalQuantity != null">total_quantity = #{totalQuantity},</if>
            <if test="status != null">status = #{status},</if>
            <if test="trackingNo != null">tracking_no = #{trackingNo},</if>
            <if test="logisticsCompany != null">logistics_company = #{logisticsCompany},</if>
            <if test="shipDate != null">ship_date = #{shipDate},</if>
            <if test="receiverName != null">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null">receiver_phone = #{receiverPhone},</if>
            <if test="receiverAddress != null">receiver_address = #{receiverAddress},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where delivery_id = #{deliveryId}
    </update>

    <update id="updateStatus">
        update sale_delivery
        set status = #{status},
            update_time = sysdate()
        where delivery_id = #{deliveryId}
    </update>

    <delete id="deleteSaleDeliveryById" parameterType="Long">
        delete from sale_delivery where delivery_id = #{deliveryId}
    </delete>

    <delete id="deleteSaleDeliveryByIds">
        delete from sale_delivery where delivery_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
