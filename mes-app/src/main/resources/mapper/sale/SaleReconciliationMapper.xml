<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carels.mes.module.sale.mapper.SaleReconciliationMapper">

    <resultMap type="com.carels.mes.module.sale.domain.SaleReconciliation" id="SaleReconciliationResult">
        <id property="reconId" column="recon_id"/>
        <result property="reconNo" column="recon_no"/>
        <result property="clientId" column="client_id"/>
        <result property="clientName" column="client_name"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="deliveryAmount" column="delivery_amount"/>
        <result property="returnAmount" column="return_amount"/>
        <result property="receivableAmount" column="receivable_amount"/>
        <result property="status" column="status"/>
        <result property="invoiceNo" column="invoice_no"/>
        <result property="invoiceDate" column="invoice_date"/>
        <result property="receivedAmount" column="received_amount"/>
        <result property="receiveDate" column="receive_date"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSaleReconciliationVo">
        select recon_id, recon_no, client_id, client_name, start_date, end_date,
               delivery_amount, return_amount, receivable_amount, status,
               invoice_no, invoice_date, received_amount, receive_date, remark,
               create_by, create_time, update_by, update_time
        from sale_reconciliation
    </sql>

    <select id="selectSaleReconciliationList" parameterType="com.carels.mes.module.sale.domain.SaleReconciliation" resultMap="SaleReconciliationResult">
        <include refid="selectSaleReconciliationVo"/>
        <where>
            <if test="reconNo != null and reconNo != ''">
                and recon_no like concat('%', #{reconNo}, '%')
            </if>
            <if test="clientId != null">
                and client_id = #{clientId}
            </if>
            <if test="clientName != null and clientName != ''">
                and client_name like concat('%', #{clientName}, '%')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="startDate != null">
                and start_date &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                and end_date &lt;= #{endDate}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectSaleReconciliationById" parameterType="Long" resultMap="SaleReconciliationResult">
        <include refid="selectSaleReconciliationVo"/>
        where recon_id = #{reconId}
    </select>

    <insert id="insertSaleReconciliation" parameterType="com.carels.mes.module.sale.domain.SaleReconciliation" useGeneratedKeys="true" keyProperty="reconId">
        insert into sale_reconciliation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reconNo != null">recon_no,</if>
            <if test="clientId != null">client_id,</if>
            <if test="clientName != null">client_name,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="deliveryAmount != null">delivery_amount,</if>
            <if test="returnAmount != null">return_amount,</if>
            <if test="receivableAmount != null">receivable_amount,</if>
            <if test="status != null">status,</if>
            <if test="invoiceNo != null">invoice_no,</if>
            <if test="invoiceDate != null">invoice_date,</if>
            <if test="receivedAmount != null">received_amount,</if>
            <if test="receiveDate != null">receive_date,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reconNo != null">#{reconNo},</if>
            <if test="clientId != null">#{clientId},</if>
            <if test="clientName != null">#{clientName},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="deliveryAmount != null">#{deliveryAmount},</if>
            <if test="returnAmount != null">#{returnAmount},</if>
            <if test="receivableAmount != null">#{receivableAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="invoiceNo != null">#{invoiceNo},</if>
            <if test="invoiceDate != null">#{invoiceDate},</if>
            <if test="receivedAmount != null">#{receivedAmount},</if>
            <if test="receiveDate != null">#{receiveDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateSaleReconciliation" parameterType="com.carels.mes.module.sale.domain.SaleReconciliation">
        update sale_reconciliation
        <trim prefix="SET" suffixOverrides=",">
            <if test="clientId != null">client_id = #{clientId},</if>
            <if test="clientName != null">client_name = #{clientName},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="deliveryAmount != null">delivery_amount = #{deliveryAmount},</if>
            <if test="returnAmount != null">return_amount = #{returnAmount},</if>
            <if test="receivableAmount != null">receivable_amount = #{receivableAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="invoiceNo != null">invoice_no = #{invoiceNo},</if>
            <if test="invoiceDate != null">invoice_date = #{invoiceDate},</if>
            <if test="receivedAmount != null">received_amount = #{receivedAmount},</if>
            <if test="receiveDate != null">receive_date = #{receiveDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where recon_id = #{reconId}
    </update>

    <update id="updateStatus">
        update sale_reconciliation
        set status = #{status},
            update_time = sysdate()
        where recon_id = #{reconId}
    </update>

    <delete id="deleteSaleReconciliationById" parameterType="Long">
        delete from sale_reconciliation where recon_id = #{reconId}
    </delete>

    <delete id="deleteSaleReconciliationByIds">
        delete from sale_reconciliation where recon_id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
